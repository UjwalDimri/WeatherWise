<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="WeatherWise gives you simple, readable weather updates and forecasts.">
  <title>WeatherWise | Understand Your Weather</title>

  <link rel="stylesheet" href="/css/home.css">
  <script src="/js/home.js" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

  <header class="navbar">
    <a href="/" class="logo">
      <span class="logo-icon">☀</span>
      Weather<span>Wise</span>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href="/" class="active">Home</a>
      <a href="#features">Features</a>
      <a href="#about">About</a>
    </nav>

    <div class="nav-actions">
      <% if (user) { %>
        <a href="/account" class="nav-button">My Account</a>
      <% } else { %>
        <a href="/login" class="nav-button">Log in</a>
      <% } %>
      <a href="#weather-search" class="nav-button">Check Weather ↗</a>
    </div>

    <button class="menu-toggle" id="menuToggle"
      aria-label="Toggle navigation" aria-expanded="false">
      ☰
    </button>
  </header>

  <main>
    <section class="hero">
      <div class="hero-content">
        <div class="eyebrow">
          <span class="status-dot"></span>
          WEATHER MADE SIMPLE
        </div>

        <h1>Understand the sky.<br>
          <span>Plan your day.</span>
        </h1>

        <p class="hero-description">
          Weather information shouldn't be complicated.
          Get the important updates you need, explained in a
          simple and readable way.
        </p>

        <form class="search-form" id="weather-search" action="/weather" method="GET">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input
            type="text"
            id="cityInput"
            name="city"
            placeholder="Enter a city, e.g. Dehradun"
            aria-label="Enter city name"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-controls="locationSuggestions"
            aria-expanded="false"
            value="<%= searchTerm || '' %>"
            required
          >
          <input type="hidden" name="latitude" id="selectedLatitude">
          <input type="hidden" name="longitude" id="selectedLongitude">
          <input type="hidden" name="admin1" id="selectedAdmin1">
          <input type="hidden" name="country" id="selectedCountry">
          <button type="submit" id="searchButton">Check Weather →</button>
        </form>

        <div class="suggestions" id="locationSuggestions" role="listbox"
          aria-label="Location suggestions" aria-busy="false" hidden></div>

        <p class="search-hint <%= error ? 'search-error' : '' %>" id="searchHint" role="status" aria-live="polite">
          <%= error || 'Try searching for your city to get started.' %>
        </p>

        <% if (!weather && Array.isArray(locations) && locations.length > 0) { %>
          <section class="location-results" aria-labelledby="location-results-title">
            <h2 id="location-results-title">Matching locations</h2>
            <p>Select the place you meant to load its current conditions.</p>
            <ul>
              <% locations.forEach((location) => { %>
                <li>
                  <form class="location-choice" action="/weather" method="GET">
                    <input type="hidden" name="city" value="<%= location.name %>">
                    <input type="hidden" name="latitude" value="<%= location.latitude %>">
                    <input type="hidden" name="longitude" value="<%= location.longitude %>">
                    <input type="hidden" name="admin1" value="<%= location.admin1 || '' %>">
                    <input type="hidden" name="country" value="<%= location.country || '' %>">
                    <button type="submit" class="location-choice-button">
                      <span class="location-name"><%= location.name %></span>
                      <span class="location-meta">
                        <%= [location.admin1, location.country].filter(Boolean).join(', ') %>
                      </span>
                      <span class="location-coordinates">
                        <%= location.latitude %>, <%= location.longitude %>
                      </span>
                      <span class="location-action">View current weather →</span>
                    </button>
                  </form>
                </li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <div class="hero-points">
          <span>✓ Easy to understand</span>
          <span>✓ Important weather data</span>
        </div>
      </div>

      <div class="hero-visual" aria-label="Weather illustration">
        <div class="visual-glow"></div>
        <div class="weather-orbit orbit-one"></div>
        <div class="weather-orbit orbit-two"></div>

        <div class="sun">☀</div>
        <div class="cloud cloud-one">☁</div>
        <div class="cloud cloud-two">☁</div>

        <% if (outfitDecorations && Array.isArray(outfitDecorations.items)) { %>
          <div class="outfit-float-layer outfit-<%= outfitDecorations.theme %>" aria-hidden="true">
            <% outfitDecorations.items.forEach((item, index) => { %>
              <span class="outfit-float outfit-float-<%= index + 1 %>"><%= item %></span>
            <% }) %>
          </div>
        <% } %>

        <div class="weather-preview">
          <div class="preview-top">
            <div>
              <span class="preview-label"><%= weather ? 'CURRENT CONDITIONS' : 'CURRENT WEATHER' %></span>
              <h3><%= selectedLocation ? [selectedLocation.name, selectedLocation.admin1, selectedLocation.country].filter(Boolean).join(', ') : 'Weather at a glance' %></h3>
            </div>
            <span class="live-indicator"><%= weather ? '● Live data' : 'Ready to search' %></span>
          </div>

          <div class="preview-middle">
            <div>
              <p class="preview-temperature"><%= weather ? weather.temperature : '—' %><%= weather ? '°C' : '' %></p>
              <p class="preview-condition"><%= weather ? weather.condition : 'Search for a location to see current conditions.' %></p>
            </div>
            <div class="preview-icon"><%= weather ? weather.icon : '🌡️' %></div>
          </div>

          <div class="preview-details">
            <div>
              <span>🌡️</span>
              <p>Feels like</p>
              <strong><%= weather && Number.isFinite(weather.feelsLike) ? `${weather.feelsLike}°C` : '—' %></strong>
            </div>
            <div>
              <span>💧</span>
              <p>Humidity</p>
              <strong><%= weather && Number.isFinite(weather.humidity) ? `${weather.humidity}%` : '—' %></strong>
            </div>
            <div>
              <span>🌬️</span>
              <p>Wind</p>
              <strong><%= weather && Number.isFinite(weather.windSpeed) ? `${weather.windSpeed} km/h` : '—' %></strong>
            </div>
            <div>
              <span>🌧️</span>
              <p>Precipitation</p>
              <strong><%= weather && Number.isFinite(weather.precipitation) ? `${weather.precipitation} mm` : '—' %></strong>
            </div>
          </div>

          <p class="preview-note">
            <%= weather ? `Updated ${weather.time} · Open-Meteo` : 'Search for a city to load live current conditions.' %>
          </p>

          <% if (Array.isArray(suggestions) && suggestions.length > 0) { %>
            <aside class="weather-tips" aria-label="Weather suggestions">
              <p class="weather-tips-heading">QUICK WEATHER TIPS</p>
              <% suggestions.forEach((tip) => { %>
                <div class="weather-tip">
                  <span class="weather-tip-icon" aria-hidden="true"><%= tip.icon %></span>
                  <p><%= tip.message %></p>
                </div>
              <% }) %>
            </aside>
          <% } %>
        </div>
      </div>
    </section>

    <% if (Array.isArray(forecast) && forecast[0] && (forecast[0].sunrise || forecast[0].sunset)) { %>
      <section class="daylight-section" aria-labelledby="daylight-title">
        <article class="daylight-card">
          <div class="daylight-heading">
            <div class="daylight-heading-icon" aria-hidden="true">🌅</div>
            <div>
              <span class="eyebrow">TODAY'S DAYLIGHT</span>
              <h2 id="daylight-title">Sunrise &amp; sunset</h2>
              <p><%= selectedLocation ? [selectedLocation.name, selectedLocation.country].filter(Boolean).join(', ') : 'Selected location' %> · local time</p>
            </div>
          </div>
          <div class="daylight-times">
            <div class="daylight-time">
              <span class="daylight-symbol sunrise-symbol" aria-hidden="true">☀️</span>
              <div><span>Sunrise</span><strong><%= forecast[0].sunrise || 'Unavailable' %></strong></div>
            </div>
            <div class="daylight-time">
              <span class="daylight-symbol sunset-symbol" aria-hidden="true">🌇</span>
              <div><span>Sunset</span><strong><%= forecast[0].sunset || 'Unavailable' %></strong></div>
            </div>
          </div>
          <p class="daylight-date"><%= forecast[0].date %></p>
        </article>
      </section>
    <% } %>

    <% if (Array.isArray(forecast) && forecast.length > 0) { %>
      <section class="forecast-section" aria-labelledby="forecast-title">
        <div class="forecast-heading">
          <div>
            <span class="eyebrow">THE WEEK AHEAD</span>
            <h2 id="forecast-title">5- and 7-day forecast</h2>
            <p>Daily conditions for <%= selectedLocation ? selectedLocation.name : 'your location' %>.</p>
          </div>
          <div class="forecast-range" role="group" aria-label="Forecast length">
            <button type="button" data-forecast-range="5" aria-pressed="false">5 days</button>
            <button type="button" data-forecast-range="7" aria-pressed="true">7 days</button>
          </div>
        </div>

        <div class="forecast-grid" id="forecastCards">
          <% forecast.forEach((day, index) => { %>
            <article class="forecast-card" data-forecast-index="<%= index %>">
              <h3><%= day.dayLabel %></h3>
              <p class="forecast-date"><%= day.date %></p>
              <span class="forecast-icon" role="img" aria-label="<%= day.condition %>"><%= day.icon %></span>
              <p class="forecast-condition"><%= day.condition %></p>
              <p class="forecast-temperatures">
                <strong><%= Number.isFinite(day.high) ? `${Math.round(day.high)}°` : '—' %></strong>
                <span><%= Number.isFinite(day.low) ? `${Math.round(day.low)}°` : '—' %></span>
              </p>
              <div class="forecast-details">
                <span>🌧️ <%= Number.isFinite(day.precipitationProbability) ? `${day.precipitationProbability}%` : '—' %></span>
                <span>💨 <%= Number.isFinite(day.windSpeed) ? `${Math.round(day.windSpeed)} km/h` : '—' %></span>
              </div>
            </article>
          <% }) %>
        </div>
        <p class="forecast-source">Daily forecast from Open-Meteo. Temperatures shown in °C.</p>
      </section>
    <% } %>

    <section class="features section" id="features">
      <div class="section-heading">
        <span class="eyebrow">WHAT YOU GET</span>
        <h2>Everything important.<br><span>Nothing complicated.</span></h2>
        <p>Quickly understand the conditions outside without digging through confusing data.</p>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon temperature">🌡️</div>
          <h3>Temperature</h3>
          <p>Understand how hot or cold it is, with temperatures in Celsius.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon humidity">💧</div>
          <h3>Humidity</h3>
          <p>See how much moisture is in the air and what it means for your day.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon wind">🌬️</div>
          <h3>Wind & Rain</h3>
          <p>Check wind speed and rainfall information to plan outdoor activities.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon forecast">📅</div>
          <h3>Weather Forecast</h3>
          <p>Get a clearer picture of expected conditions and upcoming changes.</p>
        </article>
      </div>
    </section>

    <section class="about-section" id="about">
      <div class="about-icon">🌦️</div>
      <div>
        <span class="eyebrow">ABOUT WEATHERWISE</span>
        <h2>Weather information for everyone.</h2>
        <p>
          WeatherWise aims to make essential weather data accessible,
          clear and useful. Our goal is to help people understand current
          conditions and make more informed everyday plans.
        </p>
      </div>
      <a href="#weather-search" class="about-button">Explore Weather →</a>
    </section>
  </main>

  <footer class="footer">
    <a href="/" class="logo">
      <span class="logo-icon">☀</span>
      Weather<span>Wise</span>
    </a>
    <p>Clear skies start with clear information.</p>
    <span class="copyright">© <span id="currentYear"></span> WeatherWise</span>
  </footer>

</body>
</html>
